pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'clone the code'
            }
        }
        stage('compile') {
            steps {
                echo 'compile the code'
            }
        }
        stage('Build') {
            steps {
                echo 'Build the code'
            }
        }
        stage('Test') {
            steps {
                echo 'Test the code'
            }
        }
    }
}

